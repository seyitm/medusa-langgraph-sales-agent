NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
TRUST_PROXY=false
ENABLE_API_DOCS=true
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medusa_agent
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_test_replace_me

MODEL_PROVIDER=openai
MODEL_NAME=replace-with-a-tool-capable-model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=medusa-sales-agent
JWT_AUDIENCE=medusa-storefront
SESSION_ISSUER_KEY=replace-with-an-independent-random-secret
SESSION_TOKEN_TTL_SECONDS=900
APPROVAL_TTL_SECONDS=600
THREAD_RETENTION_DAYS=30

CORS_ORIGINS=http://localhost:8000,http://localhost:3000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
METRICS_TOKEN=

# Optional live smoke tests (pnpm test:smoke)
RUN_LIVE_SMOKE=false
OPENAI_SMOKE_MODEL=
ANTHROPIC_SMOKE_MODEL=
SMOKE_REGION_ID=
